<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Periodic auto-resume wake-up for C Brain.
     Drains the pending-distill.json queue as soon as the quota resets,
     sans avoir besoin d'ouvrir une session.

     TEMPLATE — do not install this file as is: __HOME__ must be
     substituted with the real $HOME (install.sh does it automatically
     through `sed`). Written after a bug where a home path was hardcoded
     dur et cassait silencieusement la reprise sur toute nouvelle machine. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claudebrain.resume</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__HOME__/claude-brain/hooks/resume_pending.py</string>
    </array>
    <!-- launchd starts with a minimal PATH (/usr/bin:/bin:/usr/sbin:/sbin) that does NOT contain
         ~/.local/bin where `claude` lives → resume_pending never found the binary and the
         autonomous resume at quota reset was inoperative. We give it a full PATH. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/claude-brain/sessions/resume.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/claude-brain/sessions/resume.log</string>
</dict>
</plist>
